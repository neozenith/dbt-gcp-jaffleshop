# Copy to .env and fill in. .env is gitignored — never commit real values.
# profiles.yml reads every value below via env_var(). Variables without a
# default in profiles.yml MUST be set or dbt will refuse to run.

# Selects which output stanza in profiles.yml is active. Override with --target on the CLI.
DBT_TARGET=dev

# Auth method: oauth (uses gcloud ADC), service-account, service-account-json, oauth-secrets.
DBT_BQ_METHOD=oauth

# Required: GCP project IDs — no defaults in profiles.yml on purpose (wrong project = data in someone else's GCP).
DBT_BQ_PROJECT_DEV=
DBT_BQ_PROJECT_TEST=
DBT_BQ_PROJECT_PROD=

# Shared knobs with defaults — override only if needed.
DBT_BQ_LOCATION=US
DBT_BQ_THREADS=4
DBT_BQ_TIMEOUT_SECS=300

# --- Custom naming macros (slice + env detection) ---
# DBT_ENV_TYPE defaults to target.name; override only to decouple env from target.
# DBT_ENV_TYPE=DEV
#
# DEV slice: any one of these provides the branch name (in priority order).
# DBT_CLOUD_GIT_BRANCH=feature/my-branch
# DBT_GIT_BRANCH=feature/my-branch
# GIT_BRANCH=feature/my-branch
#
# TEST slice: both must be set in CI for the PR_RUN slice to assemble.
# DBT_CLOUD_PR_ID=123
# DBT_CLOUD_RUN_ID=456
