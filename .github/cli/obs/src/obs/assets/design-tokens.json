{
  "_about": "Single source of truth for obs viewer branding. THREE brand styles, each with light + dark themes. obs.js fetches this at runtime and (a) injects each theme's `chrome` palette onto CSS custom properties (the sidebar/controls), (b) feeds the `plotly` + `gantt` palettes to the canvases (which can't read CSS vars). resourceColours/statusColours are SHARED across brands — they encode data, not brand. Curate here; re-serve, refresh. No rebuild.",
  "version": 2,
  "defaultBrand": "karaoke",
  "defaultTheme": "system",
  "resourceColours": {
    "_note": "Gantt bar fill by resource_type. Shared across brands (semantic data encoding, colour-blind-safe).",
    "model": "#3b82f6",
    "test": "#a855f7",
    "unit_test": "#ec4899",
    "seed": "#10b981",
    "snapshot": "#f59e0b",
    "source": "#6b7280",
    "exposure": "#ef4444",
    "saved_query": "#14b8a6",
    "operation": "#8a99a1",
    "_fallback": "#94a3b8"
  },
  "statusColours": {
    "_note": "Pass/fail semantics shared by the Gantt bar stroke and (via per-theme markers) the overview scatter.",
    "pass": "#10b981",
    "success": "#10b981",
    "fail": "#ef4444",
    "failed": "#ef4444",
    "error": "#ef4444",
    "warn": "#f59e0b",
    "skipped": "#6b7280",
    "_fallback": "#94a3b8"
  },
