{
  "_about": "Single source of truth for obs viewer branding (Cartology design system). obs.html carries the CHROME palette as CSS variables per [data-theme]; obs.js fetches THIS file at runtime to colour the CANVAS surfaces that can't read CSS vars — the Plotly overview scatter and the SVG Gantt. Curate colours/fonts here; re-serve, refresh. No rebuild.",
  "version": 1,
  "defaultTheme": "system",
  "brand": {
    "name": "obs",
    "tagline": "dbt run telemetry"
  },
  "fonts": {
    "sans": "\"Poppins\", ui-sans-serif, system-ui, -apple-system, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
  },
  "resourceColours": {
    "_note": "Gantt bar fill by resource_type (Cartology canvas palette, extended for obs node kinds).",
    "model": "#3b82f6",
    "test": "#a855f7",
    "unit_test": "#ec4899",
    "seed": "#10b981",
    "snapshot": "#f59e0b",
    "source": "#6b7280",
    "exposure": "#ef4444",
    "saved_query": "#14b8a6",
    "operation": "#8a99a1",
    "_fallback": "#94a3b8"
  },
  "statusColours": {
    "_note": "Pass/fail semantics shared by the Gantt bar stroke and the overview scatter marks.",
    "pass": "#10b981",
    "success": "#10b981",
    "fail": "#ef4444",
    "failed": "#ef4444",
    "error": "#ef4444",
    "warn": "#f59e0b",
    "skipped": "#6b7280",
    "_fallback": "#94a3b8"
  },
  "themes": {
    "dark": {
      "name": "dark",
      "toggleLabel": "☽ Dark",
      "laneBandA": "#242C30",
      "laneBandB": "#2D373D",
      "grid": "#3A474E",
      "axisText": "#ACB5B9",
      "barStroke": "rgba(0,0,0,0.40)",
      "plotly": {
        "paper": "#242C30",
        "plot": "#2D373D",
        "font": "#E3E6E7",
        "grid": "#3A474E",
        "axisLine": "#4B5C65",
        "markerPass": "#6EE7B7",
        "markerFail": "#FCA5A5",
        "markerLine": "#242C30",
        "hoverBg": "#1B2125",
        "hoverBorder": "#4B5C65",
        "accent": "#A5C84D"
      }
    },
    "light": {
      "name": "light",
      "toggleLabel": "☼ Light",
      "laneBandA": "#FFFFFF",
      "laneBandB": "#F1F3F4",
      "grid": "#DDE0E2",
      "axisText": "#56656D",
      "barStroke": "rgba(27,33,37,0.18)",
      "plotly": {
        "paper": "#FFFFFF",
        "plot": "#F1F3F4",
        "font": "#28323A",
        "grid": "#DDE0E2",
        "axisLine": "#C2C8CB",
        "markerPass": "#0D6B30",
        "markerFail": "#C2151B",
        "markerLine": "#FFFFFF",
        "hoverBg": "#FFFFFF",
        "hoverBorder": "#C2C8CB",
        "accent": "#46630F"
      }
    }
  }
}
